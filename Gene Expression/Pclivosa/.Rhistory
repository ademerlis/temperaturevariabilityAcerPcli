all_annotDEGs <- read_csv("results_csv/host/host_all_contrasts_annotDEGs.csv")
library(tidyverse)
all_annotDEGs <- read_csv("results_csv/host/host_all_contrasts_annotDEGs.csv")
load("Rdata_files/host/pvals.RData")
# code from venn diagram
degs_Treatment_Variable_vs_Control_L2FC1=row.names(Treatment_Variable_vs_Control)[Treatment_Variable_vs_Control$padj<0.05 & !(is.na(Treatment_Variable_vs_Control$padj)) & abs(Treatment_Variable_vs_Control$log2FoldChange)>1]
degs_Treatment_Variable_vs_Initial_L2FC1=row.names(Treatment_Variable_vs_Initial)[Treatment_Variable_vs_Initial$padj<0.05 & !(is.na(Treatment_Variable_vs_Initial$padj)) & abs(Treatment_Variable_vs_Initial$log2FoldChange)>1]
degs_Treatment_Control_vs_Initial_L2FC1=row.names(Treatment_Control_vs_Initial)[Treatment_Control_vs_Initial$padj<0.05 & !(is.na(Treatment_Control_vs_Initial$padj)) & abs(Treatment_Control_vs_Initial$log2FoldChange)>1]
pairwise_LFC1=list("Control vs. Initial"=degs_Treatment_Control_vs_Initial_L2FC1, "Variable vs. Initial"=degs_Treatment_Variable_vs_Initial_L2FC1,"Variable vs. Control"=degs_Treatment_Variable_vs_Control_L2FC1)
v.table <- gplots::venn(pairwise_LFC1)
print(v.table)
all_intersections <- attr(v.table, "intersections")
for (comparison in names(all_intersections)) {
cat(comparison, "\n")
print(all_intersections[[comparison]])
}
length(all_intersections$`Variable vs. Control`) #4
genes_VvC <- all_intersections$`Variable vs. Control`
length(all_intersections$`Variable vs. Initial`) #47
genes_VvI <- all_intersections$`Variable vs. Initial`
length( all_intersections$`Variable vs. Initial:Variable vs. Control`) #4
genes_V <- all_intersections$`Variable vs. Initial:Variable vs. Control`
all_genes <- c(genes_V, genes_VvC, genes_VvI) %>%
as.data.frame() %>%  #583 total
dplyr::rename(gene = ".")
Variable_genes_annot<-left_join(all_genes, all_annotDEGs) #number is higher because the genes that overlap have two rows for each contrast
Variable_genes_annot %>%
top_n(n = 20, abs(log2FoldChange)) -> top20genes
Variable_genes_annot %>%
top_n(n = 10, abs(log2FoldChange)) -> top10genes
# write_csv(top20genes, "Pcli_host_top20DEGs.csv")
