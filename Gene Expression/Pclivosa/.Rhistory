ad.pcoa$values # the % variation explained by each axis is the Relative_eig column
plot(scores[,1], scores[,2], pch=c(15,17,25)[as.numeric(as.factor(conditions$Genotype))], col=c("#00CCCC", "grey","#FF3333")[as.numeric(as.factor(conditions$Treatment))], xlab="PC1: 13%", ylab="PC2: 4%", main="Treatment")
ordispider(scores[,1:2], conditions$Treatment,col=c("#00CCCC", "grey", "#FF3333"))
legend("topright", legend=c("Control", "Initial", "Variable"), fill = c("#00CCCC", "grey", "#FF3333"), bty="n")
legend("topleft", legend=c("A", "B", "C"), pch=c(15,17,25), bty="n")
