summary(Treatment_Variable_vs_Initial, alpha = 0.05)
Treatment_Variable_vs_Initial %>%
as.data.frame() %>%
filter(padj<0.05 & log2FoldChange > 1) %>%
nrow() #1
Treatment_Variable_vs_Initial %>%
as.data.frame() %>%
filter(padj<0.05 & log2FoldChange > 1)
Treatment_Variable_vs_Initial %>%
as.data.frame() %>%
rownames_to_column(var = "gene") %>%
drop_na(padj) %>%
filter(padj<0.05 & abs(log2FoldChange) >1) %>%
full_join(., iso2geneName, by = "gene") %>%
drop_na(baseMean) %>%
select(gene, annot, baseMean:padj) %>%
write_csv("Symbiont_VariablevInitial_annotDGEs.csv")
read.table(file = "1_bioinformatics/Breviolum_iso2geneName.tab",
sep = "\t",
quote="", fill=FALSE) %>%
rename(gene = V1,
annot = V2) -> iso2geneName
Treatment_Variable_vs_Initial %>%
as.data.frame() %>%
rownames_to_column(var = "gene") %>%
drop_na(padj) %>%
filter(padj<0.05 & abs(log2FoldChange) >1) %>%
full_join(., iso2geneName, by = "gene") %>%
drop_na(baseMean) %>%
select(gene, annot, baseMean:padj) %>%
