shapiro_test(Acer_lm_2$residuals) #significant
leveneTest(percent_change ~ Treatment, data = Acer_lm_2) #not significant
View(Acer_calc_bw_noout)
leveneTest(percent_change ~ Treatment, data = Acer_calc_bw_noout) #not significant
aov(percent_change ~ Treatment, data = Acer_calc_bw_noout)
summary(aov(percent_change ~ Treatment, data = Acer_calc_bw_noout))
summary(aov(percent_change ~ Treatment, data = Pcli_calc_bw) #significant
summary(aov(percent_change ~ Treatment, data = Pcli_calc_bw)) #significant
summary(aov(percent_change ~ Treatment, data = Pcli_calc_bw)) #significant
Pcli_lm <- aov(percent_change ~ Treatment, data = Pcli_calc_bw)
