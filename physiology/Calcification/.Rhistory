rbind(Acer_calc_bw_noout, Pcli_calc_bw_noout) %>%
group_by(Treatment, Species) %>%
mutate(mean_growth = mean(percent_change), se_growth = std.error(percent_change)) %>%
ggplot(., aes(x=Species, y = mean_growth, color = Treatment)) +
geom_point(position=position_dodge(width = 0.2)) +
geom_errorbar(aes(ymin = mean_growth - se_growth, ymax = mean_growth + se_growth), width = 0.1) +
theme_classic() +
scale_color_manual(labels=c("Treated", "Untreated"), values = c("#F54A34", "#60DBDB"))  +
theme(text = element_text(size = 15)) +
labs(y= "% Growth") +
ylim(0,15)
