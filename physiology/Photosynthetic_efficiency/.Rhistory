ggplot(., aes(x=Date, y=mean_fvfm, color = Treatment)) +
scale_color_manual(labels=c("Variable", "Control"), values = c("#F54A34", "#60DBDB")) +
geom_errorbar(aes(ymin = mean_fvfm - se_fvfm, ymax = mean_fvfm + se_fvfm), width = 0.2) +
geom_point() +
geom_line() +
theme_classic() +
labs(x="Date", y="Fv/Fm", title = "A. cervicornis") +
theme(text = element_text(size = 12)) +
ylim(0.7, 1) +
geom_vline(xintercept = as.numeric(as.Date(c("2022-03-22", "2022-04-20"))), linetype = "dashed", color = "black", alpha = 0.2)
